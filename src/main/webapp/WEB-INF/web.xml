<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" id="WebApp_ID" version="4.0">
  <display-name>MiniDmart01</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
  </session-config>

  <!-- ==================== Filters ==================== -->
  <filter>
    <filter-name>SecurityHeadersFilter</filter-name>
    <filter-class>com.minidmart.filter.SecurityHeadersFilter</filter-class>
  </filter>
  <filter>
    <filter-name>FlashFilter</filter-name>
    <filter-class>com.minidmart.filter.FlashFilter</filter-class>
  </filter>
  <filter>
    <filter-name>CartCountFilter</filter-name>
    <filter-class>com.minidmart.filter.CartCountFilter</filter-class>
  </filter>
  <filter>
    <filter-name>AuthenticationFilter</filter-name>
    <filter-class>com.minidmart.filter.AuthenticationFilter</filter-class>
  </filter>
  <filter>
    <filter-name>StaffAccessFilter</filter-name>
    <filter-class>com.minidmart.filter.StaffAccessFilter</filter-class>
  </filter>
  <filter>
    <filter-name>AdminAccessFilter</filter-name>
    <filter-class>com.minidmart.filter.AdminAccessFilter</filter-class>
  </filter>

  <filter-mapping>
    <filter-name>SecurityHeadersFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>FlashFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>CartCountFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthenticationFilter</filter-name>
    <url-pattern>/profile/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthenticationFilter</filter-name>
    <url-pattern>/cart/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthenticationFilter</filter-name>
    <url-pattern>/checkout/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthenticationFilter</filter-name>
    <url-pattern>/orders/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthenticationFilter</filter-name>
    <url-pattern>/returns/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthenticationFilter</filter-name>
    <url-pattern>/staff/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthenticationFilter</filter-name>
    <url-pattern>/admin/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>StaffAccessFilter</filter-name>
    <url-pattern>/staff/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AdminAccessFilter</filter-name>
    <url-pattern>/admin/*</url-pattern>
  </filter-mapping>

  <!-- ==================== Servlets ==================== -->

  <!-- Public / Home -->
  <servlet>
    <servlet-name>HomeServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.HomeServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>HomeServlet</servlet-name>
    <url-pattern>/home</url-pattern>
  </servlet-mapping>

  <!-- Auth -->
  <servlet>
    <servlet-name>RegisterServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.auth.RegisterServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>RegisterServlet</servlet-name>
    <url-pattern>/register</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.auth.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.auth.LogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>

  <!-- Customer profile -->
  <servlet>
    <servlet-name>ProfileServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.customer.ProfileServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ProfileServlet</servlet-name>
    <url-pattern>/profile</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>ProfileServlet</servlet-name>
    <url-pattern>/profile/*</url-pattern>
  </servlet-mapping>

  <!-- Catalog -->
  <servlet>
    <servlet-name>ProductListServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.catalog.ProductListServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ProductListServlet</servlet-name>
    <url-pattern>/products</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>ProductDetailServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.catalog.ProductDetailServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ProductDetailServlet</servlet-name>
    <url-pattern>/products/view</url-pattern>
  </servlet-mapping>

  <!-- Cart -->
  <servlet>
    <servlet-name>CartServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.cart.CartServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CartServlet</servlet-name>
    <url-pattern>/cart</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>CartServlet</servlet-name>
    <url-pattern>/cart/*</url-pattern>
  </servlet-mapping>

  <!-- Checkout -->
  <servlet>
    <servlet-name>CheckoutServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.checkout.CheckoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CheckoutServlet</servlet-name>
    <url-pattern>/checkout</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>CheckoutServlet</servlet-name>
    <url-pattern>/checkout/*</url-pattern>
  </servlet-mapping>

  <!-- Orders -->
  <servlet>
    <servlet-name>OrderHistoryServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.orders.OrderHistoryServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>OrderHistoryServlet</servlet-name>
    <url-pattern>/orders</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>OrderDetailServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.orders.OrderDetailServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>OrderDetailServlet</servlet-name>
    <url-pattern>/orders/view</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>OrderCancelServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.orders.OrderCancelServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>OrderCancelServlet</servlet-name>
    <url-pattern>/orders/cancel</url-pattern>
  </servlet-mapping>

  <!-- Returns / Exchanges -->
  <servlet>
    <servlet-name>ReturnsServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.returns.ReturnsServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ReturnsServlet</servlet-name>
    <url-pattern>/returns</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>ReturnsServlet</servlet-name>
    <url-pattern>/returns/*</url-pattern>
  </servlet-mapping>

  <!-- Staff -->
  <servlet>
    <servlet-name>StaffDashboardServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.staff.StaffDashboardServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffDashboardServlet</servlet-name>
    <url-pattern>/staff/dashboard</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>StaffOrdersServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.staff.StaffOrdersServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffOrdersServlet</servlet-name>
    <url-pattern>/staff/orders</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>StaffOrdersServlet</servlet-name>
    <url-pattern>/staff/orders/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>StaffPickupServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.staff.StaffPickupServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffPickupServlet</servlet-name>
    <url-pattern>/staff/pickups</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>StaffDeliveryServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.staff.StaffDeliveryServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffDeliveryServlet</servlet-name>
    <url-pattern>/staff/deliveries</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>StaffInventoryServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.staff.StaffInventoryServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffInventoryServlet</servlet-name>
    <url-pattern>/staff/inventory</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>StaffInventoryServlet</servlet-name>
    <url-pattern>/staff/inventory/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>StaffReturnsServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.staff.StaffReturnsServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffReturnsServlet</servlet-name>
    <url-pattern>/staff/returns</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>StaffReturnsServlet</servlet-name>
    <url-pattern>/staff/returns/*</url-pattern>
  </servlet-mapping>

  <!-- Admin -->
  <servlet>
    <servlet-name>AdminDashboardServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.admin.AdminDashboardServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminDashboardServlet</servlet-name>
    <url-pattern>/admin/dashboard</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AdminUsersServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.admin.AdminUsersServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminUsersServlet</servlet-name>
    <url-pattern>/admin/users</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AdminUsersServlet</servlet-name>
    <url-pattern>/admin/users/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AdminProductServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.admin.AdminProductServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminProductServlet</servlet-name>
    <url-pattern>/admin/products</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AdminProductServlet</servlet-name>
    <url-pattern>/admin/products/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AdminCategoryServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.admin.AdminCategoryServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminCategoryServlet</servlet-name>
    <url-pattern>/admin/categories</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AdminCategoryServlet</servlet-name>
    <url-pattern>/admin/categories/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AdminSlotServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.admin.AdminSlotServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminSlotServlet</servlet-name>
    <url-pattern>/admin/slots</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AdminSlotServlet</servlet-name>
    <url-pattern>/admin/slots/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AdminAuditServlet</servlet-name>
    <servlet-class>com.minidmart.servlet.admin.AdminAuditServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminAuditServlet</servlet-name>
    <url-pattern>/admin/audit</url-pattern>
  </servlet-mapping>

  <!-- ==================== Error pages ==================== -->
  <error-page>
    <error-code>403</error-code>
    <location>/WEB-INF/jsp/error/403.jsp</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/jsp/error/404.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/WEB-INF/jsp/error/500.jsp</location>
  </error-page>
  <error-page>
    <exception-type>java.lang.Exception</exception-type>
    <location>/WEB-INF/jsp/error/500.jsp</location>
  </error-page>
</web-app>
