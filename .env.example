# Mini D-Mart environment variables
# Copy to .env (or set these as real environment variables / hosting-platform
# secrets) and fill in real values. Never commit a filled-in .env or db.properties.
#
# When DB_URL/DB_USER/DB_PASSWORD/DB_DRIVER are set as environment variables,
# they take precedence over src/main/resources/db.properties (see DBUtil.java).
# This lets a free hosting platform (Render, Railway, etc.) inject DB
# credentials without a properties file ever containing a real secret.

DB_URL=jdbc:mysql://localhost:3306/minidmart?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8
DB_USER=minidmart_user
DB_PASSWORD=change_me
DB_DRIVER=com.mysql.cj.jdbc.Driver
